# Copy this file to .env.local and fill in real values from your Supabase
# project settings (Project Settings -> API).
#
# NEXT_PUBLIC_ prefixed vars are exposed to the browser -- this is correct
# and expected for the URL and anon key (the anon key is designed to be
# public; RLS is what actually protects data, not secrecy of this key).
# Never put the service_role key behind a NEXT_PUBLIC_ prefix.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
